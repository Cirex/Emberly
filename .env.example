# Emberly — every environment variable, in one place.
#
# GENERATED by `bun run env:build --examples`. Values are blanked; the
# prose is carried over from the per-app templates this replaces.
#
# HOW THE REAL FILES WORK. You do not edit apps/*/.env* — those are
# generated. Edit these gitignored sources at the repo root and run
# `bun run env:build`:
#
#   .env.mobile          shared by resident / security / maintenance
#   .env.<app>           one app only
#   .env.<app>.local     dev-only overlay, emitted as that app's .env.local
#
# `bun run env:build --check` reports drift without writing anything.
#
# There is deliberately no universal layer: measured against the real
# files, every variable that repeats does so across the three Expo apps
# and nowhere else.

# ══════════════════════════════════════════════════════════════════════════
# .env.mobile
# ══════════════════════════════════════════════════════════════════════════

# Defaults to https://us.i.posthog.com when unset. Use https://eu.i.posthog.com for EU.
EXPO_PUBLIC_POSTHOG_HOST=

# --- PostHog (product analytics) --- Leave EXPO_PUBLIC_POSTHOG_KEY unset to disable analytics (capture() becomes a no-op).
EXPO_PUBLIC_POSTHOG_KEY=

# Performance tracing sample rate 0..1 (default 0.2 when a DSN is set).
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Source-map upload only. Unset ⇒ `next build` skips upload and still succeeds.  (SECRET)
SENTRY_AUTH_TOKEN=

# Used only for source-map upload. This is one of several separate Sentry projects — use this project's values.
SENTRY_ORG=

# ══════════════════════════════════════════════════════════════════════════
# .env.web
# ══════════════════════════════════════════════════════════════════════════

# Project URL. Legacy alias `NEXT_PUBLIC_SUPABASE_URL` still accepted.
SUPABASE_URL=

# Bypasses RLS. Server-only.  (SECRET)
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres URL — only for running migrations, not app runtime.  (SECRET)
SUPABASE_DB_URL=

# Public base URL of this deploy (build-time).
NEXT_PUBLIC_APP_URL=

# Server API secret.  (SECRET)
API_SECRET_KEY=

# Map-sync signing secret.  (SECRET)
MAP_SYNC_HASH_SECRET=

# Bearer for `/api/cron/*`. On Coolify, set it yourself and drive crons from an external scheduler.  (SECRET)
CRON_SECRET=

# Admin/session auth. The admin dashboard logs in with ResMan STAFF credentials (validated against the ResMan admin portal); a local admin_users row is created on first login. There is no shared admin key.  (SECRET)
ADMIN_SESSION_SECRET=

RESIDENT_SESSION_SECRET=

SELECTION_TOKEN_SECRET=

RESIDENT_ENTRY_TOKEN_SECRET=

GUEST_ENTRY_TOKEN_SECRET=

RESMAN_SESSION_SIGNING_SECRET=

# Scanner authentication. Scanner keys live ONLY in the scanner_devices table — create/rotate them from the admin Scanners page (the key is shown once). There are no env-configured scanner keys. This pepper is the HMAC secret the stored secret_hash is derived with; changing it invalidates every existing key.  (SECRET)
SCANNER_SECRET_PEPPER=

# Emergency break-glass only. Leave BLANK to disable (off by default → the only way in is a ResMan login). When set, it grants super_admin via the login form's "emergency key" field or the x-admin-key header. Rotate/unset after use.  (SECRET)
ADMIN_BREAKGLASS_KEY=

RESMAN_SESSION_SIGNATURE_MAX_AGE_MS=

RESIDENT_ACCESS_MAX_AGE_MS=

# ResMan portal adapter. Do not configure or store ResMan API credentials.
RESMAN_PORTAL_ORIGIN=

RESMAN_PORTAL_SIGN_IN_PATH=

RESMAN_PORTAL_TRANSACTIONS_PATH=

# Resident-app login gate. Residents may sign in only when their ResMan portal status is Current, Pending Renewal, or Under Eviction (always allowed). This ADDS extra statuses on top of those — comma-separated, case-insensitive — for testing with non-active accounts (e.g. "Approved,Future"). Leave blank in production. In development, "Approved" is already allowed without this.
RESIDENT_ALLOWED_PORTAL_STATUSES=

# Resend API key.  (SECRET)
RESEND_API_KEY=

# From address for guest-pass email.
RESEND_FROM_EMAIL=

# Origin used in guest-pass email links.
GUEST_PASS_EMAIL_ORIGIN=

# Holds the UniFi cloud API key server-side so it never ships to the guard app. Blank ⇒ the snapshot endpoint fails closed with 503. Mint at `unifi.ui.com → API → Create API Key` on the account that owns the console (remote access enabled).  (SECRET)
UNIFI_API_KEY=

# Server DSN.
SENTRY_DSN=

# Browser DSN (usually the same value).
NEXT_PUBLIC_SENTRY_DSN=

# Optional env label (defaults to `NODE_ENV`).
SENTRY_ENVIRONMENT=

# Optional env label (defaults to `NODE_ENV`).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# 0..1, default 0 (tracing off).
SENTRY_TRACES_SAMPLE_RATE=

# 0..1, default 0 (tracing off).
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Used only for source-map upload. This is one of several separate Sentry projects — use this project's values.
SENTRY_PROJECT=

# Used only for source-map upload. This is one of several separate Sentry projects — use this project's values.
SENTRY_ORG=

# Source-map upload only. Unset ⇒ `next build` skips upload and still succeeds.  (SECRET)
SENTRY_AUTH_TOKEN=

# ══════════════════════════════════════════════════════════════════════════
# .env.resident
# ══════════════════════════════════════════════════════════════════════════

# --- Sentry (crash + error reporting) --- This app reports to its OWN Sentry project (separate from the web + resident apps). Leave EXPO_PUBLIC_SENTRY_DSN unset to disable Sentry entirely (init is skipped).
EXPO_PUBLIC_SENTRY_DSN=

# Used only for source-map upload. This is one of several separate Sentry projects — use this project's values.
SENTRY_PROJECT=

# ══════════════════════════════════════════════════════════════════════════
# .env.security
# ══════════════════════════════════════════════════════════════════════════

# --- Sentry (crash + error reporting) --- This app reports to its OWN Sentry project (separate from the web + resident apps). Leave EXPO_PUBLIC_SENTRY_DSN unset to disable Sentry entirely (init is skipped).
EXPO_PUBLIC_SENTRY_DSN=

# Used only for source-map upload. This is one of several separate Sentry projects — use this project's values.
SENTRY_PROJECT=

# ══════════════════════════════════════════════════════════════════════════
# .env.maintenance
# ══════════════════════════════════════════════════════════════════════════

# --- Sentry (crash + error reporting) --- This app reports to its OWN Sentry project (separate from the web + resident apps). Leave EXPO_PUBLIC_SENTRY_DSN unset to disable Sentry entirely (init is skipped).
EXPO_PUBLIC_SENTRY_DSN=

# Used only for source-map upload. This is one of several separate Sentry projects — use this project's values.
SENTRY_PROJECT=

# ══════════════════════════════════════════════════════════════════════════
# .env.sync
# ══════════════════════════════════════════════════════════════════════════

# ResMan sync account username.
RESMAN_SYNC_USERNAME=

# The **rotated** password — never the old leaked value.
RESMAN_SYNC_PASSWORD=

# Property to filter reports on (`PropertyOrGroupIDs`).
RESMAN_PROPERTY_ID=

# Defaults to the Multi-South preset (`1659`).
RESMAN_ACCOUNT_ID=

# Defaults to `multisouth`.
RESMAN_SUBDOMAIN=

MLGW_SYNC_USERNAME=

MLGW_SYNC_PASSWORD=

NEXT_PUBLIC_SUPABASE_URL=

# Bypasses RLS. Server-only.  (SECRET)
SUPABASE_SERVICE_ROLE_KEY=

# --- Langbly (translation pre-cache) --- Translates work-order prose server-side on the cron sync so techs' phones don't. OPTIONAL: with no key, sync:translate-work-orders logs "skipping" and no-ops, so the pipeline is safe to run without it. Free tier is 500k chars/month; this property uses ~60k/month.  (SECRET)
LANGBLY_API_KEY=

# Optional — defaults to https://api.langbly.com. Any Google Translate v2 compatible endpoint works here.
LANGBLY_API_URL=

# ══════════════════════════════════════════════════════════════════════════
# .env.web.local
# ══════════════════════════════════════════════════════════════════════════

# Project URL. Legacy alias `NEXT_PUBLIC_SUPABASE_URL` still accepted.
SUPABASE_URL=

# Bypasses RLS. Server-only.  (SECRET)
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_LOGIN_KEY=

RESMAN_API_KEY=

# Emergency break-glass only. Leave BLANK to disable (off by default → the only way in is a ResMan login). When set, it grants super_admin via the login form's "emergency key" field or the x-admin-key header. Rotate/unset after use.  (SECRET)
ADMIN_BREAKGLASS_KEY=

# Server API secret.  (SECRET)
API_SECRET_KEY=

# Holds the UniFi cloud API key server-side so it never ships to the guard app. Blank ⇒ the snapshot endpoint fails closed with 503. Mint at `unifi.ui.com → API → Create API Key` on the account that owns the console (remote access enabled).  (SECRET)
UNIFI_API_KEY=

