# Emberly — every environment variable, in one place.
#
# GENERATED by `bun run env:build --examples`. Values are blanked; the
# prose is carried over from the per-app templates this replaces.
#
# HOW THE REAL FILES WORK. You do not edit apps/*/.env* — those are
# generated. Edit these gitignored sources at the repo root and run
# `bun run env:build`:
#
#   .env.mobile          shared by resident / security / maintenance
#   .env.<app>           one app only
#   .env.<app>.local     dev-only overlay, emitted as that app's .env.local
#
# `bun run env:build --check` reports drift without writing anything.
#
# There is deliberately no universal layer: measured against the real
# files, every variable that repeats does so across the three Expo apps
# and nowhere else.

# ══════════════════════════════════════════════════════════════════════════
# .env.mobile
# ══════════════════════════════════════════════════════════════════════════

# Defaults to https://us.i.posthog.com when unset. Use https://eu.i.posthog.com for EU.
EXPO_PUBLIC_POSTHOG_HOST=

# --- PostHog (product analytics; runtime) ----------------------------------
# Leave the key unset to ship with analytics disabled (capture() is a no-op).
EXPO_PUBLIC_POSTHOG_KEY=

# Performance tracing sample rate 0..1 (default 0.2 when a DSN is set).
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Source-map upload at build time. Upload happens ONLY when SENTRY_AUTH_TOKEN is
# set; without it `next build` skips upload and still succeeds. Org/project are
# used only for that upload.
SENTRY_AUTH_TOKEN=

# --- Sentry source-map upload (BUILD ONLY — not embedded) ------------------
# The @sentry/react-native/expo plugin uploads source maps during `eas build`
# when SENTRY_AUTH_TOKEN is set; without it the build still succeeds, just with
# unminified stack traces in Sentry. Org/project identify where maps go.
# Set SENTRY_AUTH_TOKEN as an EAS secret, never in a committed file.
SENTRY_ORG=

# ══════════════════════════════════════════════════════════════════════════
# .env.web
# ══════════════════════════════════════════════════════════════════════════

# Supabase
SUPABASE_URL=

# No anon key: the web app is server-side only (service-role client + API
# routes); it has no browser Supabase client, so the anon key is never read.
SUPABASE_SERVICE_ROLE_KEY=

# Production database migration target.
#
# Copy to `.env.production` (gitignored) and fill in the direct Postgres
# connection string for the production Supabase project, then:
#   bun run db:migrate:prod
#
# This is the DIRECT Postgres URL (not the REST URL / anon / service-role key).
# Find it in the Coolify Supabase config.
#
# TLS: managed Postgres wants SSL; self-hosted / Coolify Postgres often has no
# TLS on the container. If you hit "The server does not support SSL connections",
# append ?sslmode=disable (or set SUPABASE_DB_SSL=disable).
#
# SECRET — lives only in this gitignored file locally and in Coolify's secrets.
SUPABASE_DB_URL=

# App runtime. Set this to the deployed Emberly web URL (the Coolify origin).
NEXT_PUBLIC_APP_URL=

API_SECRET_KEY=

MAP_SYNC_HASH_SECRET=

# Cron auth. Coolify does NOT set this automatically — pick a value yourself and
# have an external scheduler call /api/cron/* with: Authorization: Bearer <value>
CRON_SECRET=

# Admin/session auth. The admin dashboard logs in with ResMan STAFF credentials
# (validated against the ResMan admin portal); a local admin_users row is created
# on first login. There is no shared admin key.
ADMIN_SESSION_SECRET=

RESIDENT_SESSION_SECRET=

SELECTION_TOKEN_SECRET=

RESIDENT_ENTRY_TOKEN_SECRET=

GUEST_ENTRY_TOKEN_SECRET=

RESMAN_SESSION_SIGNING_SECRET=

# Scanner authentication. Scanner keys live ONLY in the scanner_devices table —
# create/rotate them from the admin Scanners page (the key is shown once). There
# are no env-configured scanner keys. This pepper is the HMAC secret the stored
# secret_hash is derived with; changing it invalidates every existing key.
SCANNER_SECRET_PEPPER=

# Emergency break-glass only. Leave BLANK to disable (off by default → the only
# way in is a ResMan login). When set, it grants super_admin via the login form's
# "emergency key" field or the x-admin-key header. Rotate/unset after use.
ADMIN_BREAKGLASS_KEY=

RESMAN_SESSION_SIGNATURE_MAX_AGE_MS=

RESIDENT_ACCESS_MAX_AGE_MS=

# ResMan portal adapter. Do not configure or store ResMan API credentials.
RESMAN_PORTAL_ORIGIN=

RESMAN_PORTAL_SIGN_IN_PATH=

RESMAN_PORTAL_TRANSACTIONS_PATH=

# Resident-app login gate. Residents may sign in only when their ResMan portal
# status is Current, Pending Renewal, or Under Eviction (always allowed). This
# ADDS extra statuses on top of those — comma-separated, case-insensitive — for
# testing with non-active accounts (e.g. "Approved,Future"). Leave blank in
# production. In development, "Approved" is already allowed without this.
RESIDENT_ALLOWED_PORTAL_STATUSES=

# Resend
RESEND_API_KEY=

RESEND_FROM_EMAIL=

GUEST_PASS_EMAIL_ORIGIN=

# UniFi Protect camera snapshot proxy (/api/admin/map-cameras/[id]/snapshot). Holds the
# UniFi cloud API key server-side so it never ships to the guard app. Leave blank
# to disable camera snapshots (endpoint fails closed with 503).
# Mint the key at https://unifi.ui.com → API → Create API Key (use the account
# that owns the console; remote access must be enabled on the console).
UNIFI_API_KEY=

# Sentry (error monitoring). ALL optional — if the DSNs are unset, Sentry is
# fully disabled and the app/build behave normally. This app is one of three
# separate Sentry projects across the Emberly product; use this project's DSN.
# Server-side DSN (used by instrumentation.ts).
SENTRY_DSN=

# Client/browser DSN (used by instrumentation-client.ts). Usually same value.
NEXT_PUBLIC_SENTRY_DSN=

# Optional environment label reported to Sentry (defaults to NODE_ENV).
SENTRY_ENVIRONMENT=

NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Optional tracing sample rates (0..1). Default 0 (tracing off).
SENTRY_TRACES_SAMPLE_RATE=

NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

SENTRY_PROJECT=

# --- Sentry source-map upload (BUILD ONLY — not embedded) ------------------
# The @sentry/react-native/expo plugin uploads source maps during `eas build`
# when SENTRY_AUTH_TOKEN is set; without it the build still succeeds, just with
# unminified stack traces in Sentry. Org/project identify where maps go.
# Set SENTRY_AUTH_TOKEN as an EAS secret, never in a committed file.
SENTRY_ORG=

# Source-map upload at build time. Upload happens ONLY when SENTRY_AUTH_TOKEN is
# set; without it `next build` skips upload and still succeeds. Org/project are
# used only for that upload.
SENTRY_AUTH_TOKEN=

# ══════════════════════════════════════════════════════════════════════════
# .env.resident
# ══════════════════════════════════════════════════════════════════════════

# --- Sentry (crash + error reporting; runtime) -----------------------------
# This app reports to its OWN Sentry project (separate from web + the other apps).
# Leave the DSN unset to ship with Sentry fully disabled.
EXPO_PUBLIC_SENTRY_DSN=

SENTRY_PROJECT=

# ══════════════════════════════════════════════════════════════════════════
# .env.security
# ══════════════════════════════════════════════════════════════════════════

# --- Sentry (crash + error reporting; runtime) -----------------------------
# This app reports to its OWN Sentry project (separate from web + the other apps).
# Leave the DSN unset to ship with Sentry fully disabled.
EXPO_PUBLIC_SENTRY_DSN=

SENTRY_PROJECT=

# ══════════════════════════════════════════════════════════════════════════
# .env.maintenance
# ══════════════════════════════════════════════════════════════════════════

# --- Sentry (crash + error reporting; runtime) -----------------------------
# This app reports to its OWN Sentry project (separate from web + the other apps).
# Leave the DSN unset to ship with Sentry fully disabled.
EXPO_PUBLIC_SENTRY_DSN=

SENTRY_PROJECT=

# ══════════════════════════════════════════════════════════════════════════
# .env.sync
# ══════════════════════════════════════════════════════════════════════════

# --- ResMan (property-management source) ---
RESMAN_SYNC_USERNAME=

# Use the ROTATED ResMan password — never the old leaked value.
RESMAN_SYNC_PASSWORD=

# The property whose reports we filter on (PropertyOrGroupIDs). Required.
RESMAN_PROPERTY_ID=

# Optional — default to the built-in Multi-South preset (account 1659 / multisouth).
RESMAN_ACCOUNT_ID=

RESMAN_SUBDOMAIN=

MLGW_SYNC_USERNAME=

MLGW_SYNC_PASSWORD=

NEXT_PUBLIC_SUPABASE_URL=

# No anon key: the web app is server-side only (service-role client + API
# routes); it has no browser Supabase client, so the anon key is never read.
SUPABASE_SERVICE_ROLE_KEY=

# --- Langbly (translation pre-cache) ---
# Translates work-order prose server-side on the cron sync so techs' phones
# don't. OPTIONAL: with no key, sync:translate-work-orders logs "skipping" and
# no-ops, so the pipeline is safe to run without it.
# Free tier is 500k chars/month; this property uses ~60k/month.
LANGBLY_API_KEY=

# Optional — defaults to https://api.langbly.com. Any Google Translate v2
# compatible endpoint works here.
LANGBLY_API_URL=

# ══════════════════════════════════════════════════════════════════════════
# .env.web.local
# ══════════════════════════════════════════════════════════════════════════

# Supabase
SUPABASE_URL=

# No anon key: the web app is server-side only (service-role client + API
# routes); it has no browser Supabase client, so the anon key is never read.
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_LOGIN_KEY=

RESMAN_API_KEY=

# Emergency break-glass only. Leave BLANK to disable (off by default → the only
# way in is a ResMan login). When set, it grants super_admin via the login form's
# "emergency key" field or the x-admin-key header. Rotate/unset after use.
ADMIN_BREAKGLASS_KEY=

API_SECRET_KEY=

# UniFi Protect camera snapshot proxy (/api/admin/map-cameras/[id]/snapshot). Holds the
# UniFi cloud API key server-side so it never ships to the guard app. Leave blank
# to disable camera snapshots (endpoint fails closed with 503).
# Mint the key at https://unifi.ui.com → API → Create API Key (use the account
# that owns the console; remote access must be enabled on the console).
UNIFI_API_KEY=

# ══════════════════════════════════════════════════════════════════════════
# .env.security.local
# ══════════════════════════════════════════════════════════════════════════

# --- API ---
EXPO_PUBLIC_BASE_URL=

# ══════════════════════════════════════════════════════════════════════════
# .env.maintenance.local
# ══════════════════════════════════════════════════════════════════════════

# --- API ---
EXPO_PUBLIC_BASE_URL=

# Dev-only bearer token to skip sign-in during local development. Leave unset in builds.
EXPO_PUBLIC_DEV_TOKEN=
