{
  "expo": {
    "name": "Emberly Maintenance",
    "slug": "emberly-maintenance",
    "version": "1.1.0",
    "scheme": "com.emberly.maintenance",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emberly.maintenance",
      "appleTeamId": "T49DUB6KRJ",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Emberly Maintenance attaches photos from your library to property-map annotations.",
        "NSMicrophoneUsageDescription": "Emberly Maintenance uses the microphone so you can dictate work-order notes instead of typing them.",
        "NSSpeechRecognitionUsageDescription": "Emberly Maintenance transcribes your dictated notes on this device. The audio is not sent to Apple or to Emberly.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "package": "com.emberly.maintenance",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#FCF8F0"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ],
      "@sentry/react-native/expo",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "78200644-b289-4b82-8456-2fc537a44750"
      }
    },
    "owner": "buildwithsora"
  }
}
