{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.23.1",
      "cache": {
        "disabled": false
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "0.2",
        "EXPO_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE": "0.2",
        "EXPO_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "T49DUB6KRJ",
        "metadataPath": "./store.config.js"
      }
    }
  }
}
