# Emberly Manager — environment variables template.
# Copy to `.env.local` and fill in. All EXPO_PUBLIC_* vars are embedded in the
# app bundle at build time. Everything here is OPTIONAL: with these unset the
# app runs normally and observability stays completely inert (no init, no-ops).

# --- API ---
EXPO_PUBLIC_BASE_URL=http://localhost:3001
# Dev-only bearer token to skip sign-in during local development. Leave unset in builds.
EXPO_PUBLIC_DEV_TOKEN=

# --- Sentry (crash + error reporting) ---
# This app reports to its OWN Sentry project (separate from the other apps).
# Leave EXPO_PUBLIC_SENTRY_DSN unset to disable Sentry entirely (init is skipped).
EXPO_PUBLIC_SENTRY_DSN=
# Performance tracing sample rate 0..1 (default 0.2 when a DSN is set).
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2

# --- PostHog (product analytics) ---
# Leave EXPO_PUBLIC_POSTHOG_KEY unset to disable analytics (capture() becomes a no-op).
EXPO_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com when unset. Use https://eu.i.posthog.com for EU.
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
