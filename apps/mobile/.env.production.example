# Emberly Resident (@emberly/mobile) — PRODUCTION env template for EAS release.
#
# Copy to `.env.production` (gitignored) and fill in, OR — preferred for secrets —
# set these as EAS environment variables / secrets on the build profile.
#
# Two kinds of variable live here:
#   • EXPO_PUBLIC_*  → embedded into the JS bundle at build time. NOT secret.
#     Anyone can read them out of the shipped app; never put a private key here.
#   • Build-only Sentry vars (no EXPO_PUBLIC_ prefix) → used ONLY during the EAS
#     build to upload source maps. Never embedded in the app. SENTRY_AUTH_TOKEN
#     is a real secret — set it as an EAS secret, do not commit it.
#
# Everything is OPTIONAL: with all of it unset the release still builds and runs,
# just with observability disabled and the default production API host.

# --- API host (optional) ---------------------------------------------------
# Defaults to the built-in PRODUCTION_ORIGIN (https://emberly.krkn.app)
# → /api when unset. Set only to point the release at a different API origin
# (e.g. the Coolify deployment). MUST be https in production builds.
# EXPO_PUBLIC_API_BASE_URL=https://emberly.krkn.app/api

# --- Sentry (crash + error reporting; runtime) -----------------------------
# This app reports to its OWN Sentry project (separate from web + the other apps).
# Leave the DSN unset to ship with Sentry fully disabled.
EXPO_PUBLIC_SENTRY_DSN=
# Performance tracing sample rate 0..1 (default 0.2 when a DSN is set).
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2

# --- PostHog (product analytics; runtime) ----------------------------------
# Leave the key unset to ship with analytics disabled (capture() is a no-op).
EXPO_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com when unset. Use https://eu.i.posthog.com for EU.
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry source-map upload (BUILD ONLY — not embedded) ------------------
# The @sentry/react-native/expo plugin uploads source maps during `eas build`
# when SENTRY_AUTH_TOKEN is set; without it the build still succeeds, just with
# unminified stack traces in Sentry. Org/project identify where maps go.
# Set SENTRY_AUTH_TOKEN as an EAS secret, never in a committed file.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
