    "prepare:ios:expo-jsi": "bun scripts/prepare-expo-modules-jsi.mjs",
    "test": "e=0; for f in tests/*.test.js; do bun test \"$f\" || e=1; done; exit $e",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emberly/core": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@sentry/react-native": "^8.18.0",
    "axios": "^1.18.1",
    "expo": "^57.0.4",
    "expo-application": "~57.0.0",
    "expo-build-properties": "~57.0.3",
    "expo-constants": "~57.0.3",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-local-authentication": "~57.0.0",
    "expo-localization": "~57.0.0",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "posthog-react-native": "^4.55.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.0",
    "text-encoding": "^0.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.17",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.36.0",
    "eslint-config-expo": "^57.0.0",
    "typescript": "^6.0.3"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "overrides": {
    "uuid": "^11.1.1"
