# Supabase
SUPABASE_URL=https://llnarcpxyulbzxqlqqey.supabase.co
# No anon key: the web app is server-side only (service-role client + API
# routes); it has no browser Supabase client, so the anon key is never read.
SUPABASE_SERVICE_ROLE_KEY=
# Required only when applying migrations with scripts/apply-supabase-migrations.mjs.
SUPABASE_DB_URL=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="Emberly Guest Passes <guest-passes@notifications.emberlyapartments.com>"
GUEST_PASS_EMAIL_ORIGIN=https://notifications.emberlyapartments.com


# Scanner authentication. Scanner keys live ONLY in the scanner_devices table —
# create/rotate them from the admin Scanners page (the key is shown once). There
# are no env-configured scanner keys. This pepper is the HMAC secret the stored
# secret_hash is derived with; changing it invalidates every existing key.
SCANNER_SECRET_PEPPER=

# Admin/session auth. The admin dashboard logs in with ResMan STAFF credentials
# (validated against the ResMan admin portal); a local admin_users row is created
# on first login. There is no shared admin key.
ADMIN_SESSION_SECRET=
# Emergency break-glass only. Leave BLANK to disable (off by default → the only
# way in is a ResMan login). When set, it grants super_admin via the login form's
# "emergency key" field or the x-admin-key header. Rotate/unset after use.
ADMIN_BREAKGLASS_KEY=
RESIDENT_SESSION_SECRET=
SELECTION_TOKEN_SECRET=
RESIDENT_ENTRY_TOKEN_SECRET=
GUEST_ENTRY_TOKEN_SECRET=
RESMAN_SESSION_SIGNING_SECRET=
RESMAN_SESSION_SIGNATURE_MAX_AGE_MS=604800000
RESIDENT_ACCESS_MAX_AGE_MS=1200000

# ResMan portal adapter. Do not configure or store ResMan API credentials.
RESMAN_PORTAL_ORIGIN=https://multisouth.myresman.com
RESMAN_PORTAL_SIGN_IN_PATH=/Portal/Access/SignIn/Emberly
RESMAN_PORTAL_TRANSACTIONS_PATH=/Portal/Transactions

# Resident-app login gate. Residents may sign in only when their ResMan portal
# status is Current, Pending Renewal, or Under Eviction (always allowed). This
# ADDS extra statuses on top of those — comma-separated, case-insensitive — for
# testing with non-active accounts (e.g. "Approved,Future"). Leave blank in
# production. In development, "Approved" is already allowed without this.
RESIDENT_ALLOWED_PORTAL_STATUSES=

# App runtime. Set this to the deployed Emberly web URL (the Coolify origin).
NEXT_PUBLIC_APP_URL=https://emberly.krkn.app
API_SECRET_KEY=
MAP_SYNC_HASH_SECRET=

# Private read-only property-management REST API (/api/resman/*). No shared key:
# access is by a per-user API token (mint one on the admin "Access Tokens" page,
# kind=API → `Authorization: Bearer eapi_…`) or a scanner credential
# (`?scannerId=<id>` + the scanner secret). Fails closed.

# UniFi Protect camera snapshot proxy (/api/admin/map-cameras/[id]/snapshot). Holds the
# UniFi cloud API key server-side so it never ships to the guard app. Leave blank
# to disable camera snapshots (endpoint fails closed with 503).
# Mint the key at https://unifi.ui.com → API → Create API Key (use the account
# that owns the console; remote access must be enabled on the console).
UNIFI_API_KEY=

# Cron auth. Coolify does NOT set this automatically — pick a value yourself and
# have an external scheduler call /api/cron/* with: Authorization: Bearer <value>
CRON_SECRET=

# Sentry (error monitoring). ALL optional — if the DSNs are unset, Sentry is
# fully disabled and the app/build behave normally. This app is one of three
# separate Sentry projects across the Emberly product; use this project's DSN.
# Server-side DSN (used by instrumentation.ts).
SENTRY_DSN=
# Client/browser DSN (used by instrumentation-client.ts). Usually same value.
NEXT_PUBLIC_SENTRY_DSN=
# Optional environment label reported to Sentry (defaults to NODE_ENV).
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional tracing sample rates (0..1). Default 0 (tracing off).
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Source-map upload at build time. Upload happens ONLY when SENTRY_AUTH_TOKEN is
# set; without it `next build` skips upload and still succeeds. Org/project are
# used only for that upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Deployment-only values such as VERCEL_TOKEN, VERCEL_ORG_ID, and
# VERCEL_PROJECT_ID should not be added to the app runtime environment.
