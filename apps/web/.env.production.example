# Production database migration target.
#
# Copy to `.env.production` (gitignored) and fill in the direct Postgres
# connection string for the production Supabase project, then:
#   bun run db:migrate:prod
#
# This is the DIRECT Postgres URL (not the REST URL / anon / service-role key).
# Find it in the Coolify Supabase config.
#
# TLS: managed Postgres wants SSL; self-hosted / Coolify Postgres often has no
# TLS on the container. If you hit "The server does not support SSL connections",
# append ?sslmode=disable (or set SUPABASE_DB_SSL=disable).
#
# SECRET — lives only in this gitignored file locally and in Coolify's secrets.
SUPABASE_DB_URL=postgresql://postgres:<DB_PASSWORD>@db.emberly.krkn.app:54322/postgres?sslmode=disable
