# ── Supabase (minimal stack) — per-deployment environment ────────────────────
# Copy to .env, fill in, and paste into Coolify's Environment Variables tab.
# EVERY deployment needs its OWN values. Reusing JWT_SECRET across instances
# means a token minted by one is valid against the other.

# ── Secrets ──────────────────────────────────────────────────────────────────
# 40+ chars. Generate:  openssl rand -base64 48 | tr -d '\n/+=' | head -c 64
JWT_SECRET=
# Generate:  openssl rand -base64 36 | tr -d '\n/+='
POSTGRES_PASSWORD=

# Both are JWTs SIGNED WITH JWT_SECRET — they are not random strings and
# Coolify cannot generate them. Mint with the helper:
#     ./mint-keys.sh "$JWT_SECRET"
ANON_KEY=
SERVICE_ROLE_KEY=

# ── Identity ─────────────────────────────────────────────────────────────────
POSTGRES_DB=postgres
# Where your frontend lives — used for auth redirects.
SITE_URL=https://app.example.com
# Comma-separated extra redirect targets. Keep this tight; it is an open-redirect
# surface if you wildcard it.
ADDITIONAL_REDIRECT_URLS=

# ── Auth posture (closed by default — open deliberately) ─────────────────────
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
# Leave false in production. True lets anyone register an address they do not own.
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
JWT_EXPIRY=3600

# ── SMTP (required for real signup/recovery email) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=

# ── API surface ──────────────────────────────────────────────────────────────
# The schemas PostgREST exposes. Add a schema per app if you are co-tenanting
# several apps in one instance (they will share auth.users — see README).
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000

# ── Storage (ignore if you deleted the storage service) ──────────────────────
FILE_SIZE_LIMIT=52428800
REGION=local
GLOBAL_S3_BUCKET=stub

# ── Tuning ───────────────────────────────────────────────────────────────────
# Kong nginx workers. Stock is one-per-core (~374 MiB on a 4-core box); 2 is
# ample here and roughly halves it.
KONG_WORKERS=2
