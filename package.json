{
  "name": "emberly",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "supabase/sync"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "web:dev": "bun run --filter '@emberly/web' dev",
    "web:build": "bun run --filter '@emberly/web' build",
    "resident:start": "bun run --filter '@emberly/resident' start",
    "sync:build": "bun run --filter '@emberly/sync' build",
    "version": "bun scripts/version.mjs",
    "release": "scripts/release.sh"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.6",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
