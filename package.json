{
  "name": "emberly",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "supabase/sync"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "web:dev": "bun run --filter '@emberly/web' dev",
    "web:build": "bun run --filter '@emberly/web' build",
    "mobile:start": "bun run --filter '@emberly/mobile' start",
    "sync:build": "bun run --filter '@emberly/sync' build"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "turbo": "^2.10.4",
    "typescript": "^6.0.3"
  }
}
