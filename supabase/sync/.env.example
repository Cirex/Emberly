# Sync worker — local test credentials.
#
# Copy this file to `.env` (which is gitignored) and fill in real values, then:
#   bun run sync:test
#
# These are SECRETS. They live ONLY in this gitignored .env locally and in the
# Coolify worker's secret store in production — never in the web/Vercel env,
# never in the iOS app, never committed.

# --- ResMan (property-management source) ---
RESMAN_SYNC_USERNAME=
# Use the ROTATED ResMan password — never the old leaked value.
RESMAN_SYNC_PASSWORD=
# The property whose reports we filter on (PropertyOrGroupIDs). Required.
RESMAN_PROPERTY_ID=
# Optional — default to the built-in Multi-South preset (account 1659 / multisouth).
RESMAN_ACCOUNT_ID=
RESMAN_SUBDOMAIN=

# --- Supabase (service role bypasses RLS — keep server-side only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Langbly (translation pre-cache) ---
# Translates work-order prose server-side on the cron sync so techs' phones
# don't. OPTIONAL: with no key, sync:translate-work-orders logs "skipping" and
# no-ops, so the pipeline is safe to run without it.
# Free tier is 500k chars/month; this property uses ~60k/month.
LANGBLY_API_KEY=
# Optional — defaults to https://api.langbly.com. Any Google Translate v2
# compatible endpoint works here.
LANGBLY_API_URL=
